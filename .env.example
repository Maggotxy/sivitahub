# Runtime
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional token for higher-rate public GitHub API reads.
# Never commit a real token.
GITHUB_TOKEN=

# Optional GitHub App connection for one-click access to selected repositories.
# Configure the GitHub App with Metadata: read and Contents: read only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the App private key only into your local .env, using escaped \n characters.
GITHUB_APP_PRIVATE_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
